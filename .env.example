# TraceMind environment configuration
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# FalkorDB connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Graph name used by the application (development)
FALKORDB_GRAPH=tracemind

# Query/connection timeout in milliseconds
FALKORDB_TIMEOUT_MS=5000

# Optional: FalkorDB password (leave blank if not configured)
# FALKORDB_PASSWORD=
